{
  // Realtime Worker — Generalized WebSocket Hub
  // Provides realtime event delivery via Durable Objects + Cloudflare Queues.
  // Any app in the ecosystem can bind to this worker via Service Binding RPC.

  "name": "realtime-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-08",
  "compatibility_flags": ["nodejs_compat"],

  // Durable Object: RealtimeHub with SQLite storage (Rule 7.4.4)
  "durable_objects": {
    "bindings": [
      { "name": "REALTIME_HUB", "class_name": "RealtimeHub" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RealtimeHub"] }
  ],

  // Service Bindings
  "services": [
    { "binding": "SSO_SERVICE", "service": "sso-api", "entrypoint": "SsoWorker" }
  ],

  // Cloudflare Queue: produces events from DOs, consumes for fan-out
  "queues": {
    "producers": [
      { "queue": "realtime-events-queue", "binding": "REALTIME_EVENTS_QUEUE" }
    ],
    "consumers": [
      {
        "queue": "realtime-events-queue",
        "max_batch_size": 100,
        "max_batch_timeout": 1
      }
    ]
  },

  // Observability: Full logging + traces (Rule 7.8)
  "dev": {
    "port": 8790
  },

  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  },

  "env": {
    "qa": {
      "name": "realtime-worker-qa",
      "account_id": "d10c2b1a3d702c710a036bc5a6d0902e",
      "durable_objects": {
        "bindings": [
          { "name": "REALTIME_HUB", "class_name": "RealtimeHub" }
        ]
      },
      "migrations": [
        { "tag": "v1", "new_sqlite_classes": ["RealtimeHub"] }
      ],
      "services": [
        { "binding": "SSO_SERVICE", "service": "sso-api-qa", "entrypoint": "SsoWorker" }
      ],
      "queues": {
        "producers": [
          { "queue": "realtime-events-queue-qa", "binding": "REALTIME_EVENTS_QUEUE" }
        ],
        "consumers": [
          {
            "queue": "realtime-events-queue-qa",
            "max_batch_size": 100,
            "max_batch_timeout": 1
          }
        ]
      }
    },
    "dev": {
      "name": "realtime-worker-dev",
      "durable_objects": {
        "bindings": [
          { "name": "REALTIME_HUB", "class_name": "RealtimeHub" }
        ]
      },
      "migrations": [
        { "tag": "v1", "new_sqlite_classes": ["RealtimeHub"] }
      ],
      "services": [
        { "binding": "SSO_SERVICE", "service": "sso-api-dev", "entrypoint": "SsoWorker" }
      ],
      "queues": {
        "producers": [
          { "queue": "realtime-events-queue-dev", "binding": "REALTIME_EVENTS_QUEUE" }
        ],
        "consumers": [
          {
            "queue": "realtime-events-queue-dev",
            "max_batch_size": 100,
            "max_batch_timeout": 1
          }
        ]
      }
    }
  }
}
